# ============ ОСНОВНОЙ БОТ (bot.py) ============

# Токен от @BotFather
BOT_TOKEN=123456:ABC-YourTokenHere

# ID изначальных супер-админов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=123456789,987654321

# Необязательные настройки — можно не трогать
DB_PATH=cheats.db
THROTTLE_SECONDS=1.0
WELCOME_MEDIA_PATH=welcome.png
CHANNEL_URL=https://t.me/cfg_hvh
SUPPORT_URL=https://t.me/slive_cfg

# Адрес чекер-бота (сервис checker_bot.py на Render) и общий секрет — ОБЯЗАТЕЛЬНЫ,
# без них проверка подписки на спонсоров работать не будет.
CHECKER_URL=https://sponsor-checker.onrender.com
CHECKER_SECRET=придумайте-длинную-случайную-строку
# Необязательно: если не задать, бот сам узнает username чекер-бота через /whoami при старте
CHECKER_BOT_USERNAME=

# Порт задаёт сам Render автоматически через переменную PORT — трогать не нужно


# ============ ЧЕКЕР-БОТ (checker_bot.py) — отдельный сервис на Render ============

# Токен ВТОРОГО бота от @BotFather (отдельный бот, не такой же токен, как выше!)
CHECKER_BOT_TOKEN=654321:XYZ-CheckerTokenHere

# Тот же самый секрет, что указан выше в CHECKER_SECRET основного бота
CHECKER_SECRET=придумайте-длинную-случайную-строку

# Необязательно: ID, кому можно писать чекер-боту команду /channels (список каналов)
CHECKER_ADMIN_IDS=123456789

CHECKER_DB_PATH=checker.db
